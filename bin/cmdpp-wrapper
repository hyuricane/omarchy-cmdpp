#!/bin/bash
set -euo pipefail

# ==============================================================================
# Static Release & Security Declarations (for review verification)
# ==============================================================================
CMDPP_VERSION="0.1.2"
CMDPP_TAG="v0.1.2"
CMDPP_REPO="hyuricane/cmdpp"

# Committed SHA-256 checksums of the release tarballs (.tar.gz):
# Source: https://github.com/hyuricane/cmdpp/releases/tag/v0.1.0/checksums.txt
ARCHIVE_SHA256_AMD64="d38bfc4735e8d32e5f9b325ede2111ba374176db34fd18d6a3747beb2b1b19c9"
ARCHIVE_SHA256_ARM64="00786554aeeed7f8b2d6ac2fd1c118206da67694ea8e71c6d583570b05913aab"

# Committed SHA-256 checksums of the extracted executable (bin/cmdpp):
# Verified against every execution to prevent stale/tampered binary bypass
BINARY_SHA256_AMD64="8ead774f4d114f4f4d4b76e8d9cf350f58a1b7a8801e5fabf51a41f70bd908ae"
BINARY_SHA256_ARM64="d5522464fabc842516ffff57eb30dcb19571f93ed6bc229140dcc9b8b73643f5"

# Known previous official binary SHA-256 checksums per architecture:
# When bumping CMDPP_VERSION, add previous BINARY_SHA256_* values to their respective list below.
# Existing installations matching these hashes are recognized as legitimate upgrades rather than tampered files.
KNOWN_PREVIOUS_SHAS_AMD64=(
  "1c1e611b6c3f07426bb633655498cb292132a10f30344c5d0084af2a684458ee"
  "f63407a919d3e4cde953272d84cc80efa3e3b4df23920509f186f921566811aa"
  # Add previous BINARY_SHA256_AMD64 values here when bumping CMDPP_VERSION
)
KNOWN_PREVIOUS_SHAS_ARM64=(
  "6fe162b21aa79fe12a4f01a87dee1a560c40bc88aa92fd86d59053f03e1f7d39"
  "ddb0eb6b120018e559aca3d1b25c67cfe76c2772b9142cc6a7ab14af20ac318b"
  # Add previous BINARY_SHA256_ARM64 values here when bumping CMDPP_VERSION
)

# Security & bounded execution limits
MAX_FILESIZE=10000000  # Strict byte ceiling (10 MB)
CONNECT_TIMEOUT=10     # Connection deadline in seconds
MAX_TIME=60            # Total execution deadline in seconds
# ==============================================================================

# Helper to check if a checksum belongs to a recognized previous official release for this architecture
is_known_previous_sha() {
  local target="$1"
  for sha in "${KNOWN_PREVIOUS_SHAS[@]-}"; do
    [[ -n "$sha" ]] || continue
    if [[ "$target" == "$sha" ]]; then
      return 0
    fi
  done
  return 1
}

# Resolve CPU architecture and matching committed checksums
RAW_ARCH="$(uname -m)"
case "$RAW_ARCH" in
  x86_64|amd64)
    ARCH="amd64"
    EXPECTED_ARCHIVE_SHA="$ARCHIVE_SHA256_AMD64"
    EXPECTED_BINARY_SHA="$BINARY_SHA256_AMD64"
    KNOWN_PREVIOUS_SHAS=("${KNOWN_PREVIOUS_SHAS_AMD64[@]-}")
    ;;
  aarch64|arm64)
    ARCH="arm64"
    EXPECTED_ARCHIVE_SHA="$ARCHIVE_SHA256_ARM64"
    EXPECTED_BINARY_SHA="$BINARY_SHA256_ARM64"
    KNOWN_PREVIOUS_SHAS=("${KNOWN_PREVIOUS_SHAS_ARM64[@]-}")
    ;;
  *)
    echo "Error: Unsupported CPU architecture: $RAW_ARCH" >&2
    echo "Press any key to exit..."
    read -n 1 -s
    exit 1
    ;;
esac

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_BIN="$PLUGIN_DIR/bin/cmdpp"

IS_UPGRADE=false

# 1. Cryptographically verify local binary before execution on every launch
if [[ -f "$LOCAL_BIN" ]]; then
  ACTUAL_LOCAL_SHA="$(sha256sum "$LOCAL_BIN" | awk '{print $1}')"
  if [[ "$ACTUAL_LOCAL_SHA" == "$EXPECTED_BINARY_SHA" ]]; then
    exec "$LOCAL_BIN" "$@"
  elif is_known_previous_sha "$ACTUAL_LOCAL_SHA"; then
    # Recognized official previous release for this architecture -> Upgrade available
    IS_UPGRADE=true
  else
    # Checksum mismatch does not match target OR any known previous release for this arch -> Tampering alarm
    echo -e "\n\033[1;31m=====================================================\033[0m"
    echo -e "\033[1;31m[!] SECURITY WARNING: Tampered or Corrupted Binary    \033[0m"
    echo -e "\033[1;31m=====================================================\033[0m\n"
    echo -e "The existing local binary does not match any known official checksum for ${ARCH}."
    echo -e "  • Path:     $LOCAL_BIN"
    echo -e "  • Expected: $EXPECTED_BINARY_SHA"
    echo -e "  • Actual:   $ACTUAL_LOCAL_SHA\n"
    echo "Refusing to execute unverified binary. Removing tampered file..."
    rm -f "$LOCAL_BIN"
  fi
fi

FILE="cmdpp_${CMDPP_VERSION}_linux_${ARCH}.tar.gz"
URL="https://github.com/${CMDPP_REPO}/releases/download/${CMDPP_TAG}/${FILE}"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

handle_failure() {
  local msg="$1"
  echo -e "\033[1;31m\n  [✗] $msg\033[0m" >&2
  if [[ "$IS_UPGRADE" == true && -f "$LOCAL_BIN" ]]; then
    echo -e "\n\033[1;33m[!] Update could not be completed. Your existing binary remains untouched.\033[0m"
    read -r -p "Launch existing verified version instead? [Y/n] " fallback_confirm || fallback_confirm=""
    case "$fallback_confirm" in
      [nN][oO]|[nN])
        exit 1
        ;;
      *)
        exec "$LOCAL_BIN" "$@"
        ;;
    esac
  fi
  read -n 1 -s -r -p "Press any key to exit..."
  echo ""
  exit 1
}

# ==============================================================================
# Step 1: Request User Permission Before Download
# ==============================================================================
if [[ "$IS_UPGRADE" == true ]]; then
  echo -e "\n\033[1;36m=====================================================\033[0m"
  echo -e "\033[1m              Command++ (yuri.cmdpp)                \033[0m"
  echo -e "\033[1;36m=====================================================\033[0m\n"
  echo -e "A new version of \033[1mcmdpp\033[0m is available in this plugin."
  echo -e "Your current binary is a verified official previous version.\n"
  echo -e "\033[1mUpdate Details:\033[0m"
  echo -e "  • Target Version: ${CMDPP_TAG}"
  echo -e "  • Architecture:   ${ARCH}"
  echo -e "  • Source URL:     https://github.com/${CMDPP_REPO}/releases/tag/${CMDPP_TAG}"
  echo -e "  • Destination:    ${LOCAL_BIN}"
  echo -e "  • Target SHA:     ${EXPECTED_BINARY_SHA}\n"

  read -r -p "Do you want to download and apply this update? [Y/n] " update_confirm || update_confirm=""
  case "$update_confirm" in
    [nN][oO]|[nN])
      echo -e "\n\033[33mUpdate skipped. Launching current version...\033[0m\n"
      sleep 1
      exec "$LOCAL_BIN" "$@"
      ;;
    *)
      # Proceed to download
      ;;
  esac
else
  echo -e "\n\033[1;36m=====================================================\033[0m"
  echo -e "\033[1m              Command++ (yuri.cmdpp)                \033[0m"
  echo -e "\033[1;36m=====================================================\033[0m\n"

  echo -e "Command++ requires the \033[1mcmdpp\033[0m TUI executable to run."
  echo -e "No verified binary was found in this plugin.\n"
  echo -e "\033[1mArtifact Details:\033[0m"
  echo -e "  • Package:       cmdpp ${CMDPP_TAG}"
  echo -e "  • Architecture:  ${ARCH}"
  echo -e "  • Source URL:    https://github.com/${CMDPP_REPO}/releases/tag/${CMDPP_TAG}"
  echo -e "  • Destination:   ${LOCAL_BIN}"
  echo -e "  • Archive SHA:   ${EXPECTED_ARCHIVE_SHA}"
  echo -e "  • Binary SHA:    ${EXPECTED_BINARY_SHA}\n"

  read -r -p "Do you want to download and verify this official binary? [y/N] " download_confirm || download_confirm=""
  case "$download_confirm" in
    [yY][eE][sS]|[yY])
      ;;
    *)
      echo -e "\n\033[33mSetup cancelled by user.\033[0m"
      echo -e "You can inspect the release anytime at: https://github.com/${CMDPP_REPO}/releases\n"
      read -n 1 -s -r -p "Press any key to exit..."
      exit 0
      ;;
  esac
fi

# ==============================================================================
# Step 2: Bounded Download & Checksum Verification
# ==============================================================================
echo -e "\n\033[1;34m==> Running Security & Verification Checklist...\033[0m\n"
echo -e "  [..] Downloading release archive..."

if ! curl -fsSL \
  --connect-timeout "$CONNECT_TIMEOUT" \
  --max-time "$MAX_TIME" \
  --max-filesize "$MAX_FILESIZE" \
  -o "$TMP_DIR/$FILE" \
  "$URL"; then
  handle_failure "Download failed! Could not fetch $URL"
fi
echo -e "\033[1;32m  [✓]\033[0m Archive downloaded successfully (${FILE})"

ACTUAL_ARCHIVE_SHA="$(sha256sum "$TMP_DIR/$FILE" | awk '{print $1}')"

# ==============================================================================
# Step 3: Present Verification Checklist to User
# ==============================================================================
echo -e "\n\033[1m--- Verification Checklist ---\033[0m"
echo -e "  • Size constraint:       \033[1;32mPASS\033[0m (< $((MAX_FILESIZE / 1000000)) MB)"
echo -e "  • Expected Archive SHA:  \033[1;32m${EXPECTED_ARCHIVE_SHA}\033[0m"
echo -e "  • Actual Archive SHA:    \033[1;32m${ACTUAL_ARCHIVE_SHA}\033[0m"

if [[ "$ACTUAL_ARCHIVE_SHA" != "$EXPECTED_ARCHIVE_SHA" ]]; then
  handle_failure "ARCHIVE CHECKSUM VERIFICATION FAILED! The downloaded archive does not match the committed hash."
fi
echo -e "\033[1;32m  [✓] Archive integrity:   VERIFIED MATCH\033[0m"

# Extract binary
if ! tar -xzf "$TMP_DIR/$FILE" -C "$TMP_DIR"; then
  handle_failure "Extraction error: failed to extract archive."
fi

if [[ ! -f "$TMP_DIR/cmdpp" ]]; then
  handle_failure "Extraction error: binary 'cmdpp' not found in archive."
fi

# Verify extracted binary checksum
ACTUAL_BINARY_SHA="$(sha256sum "$TMP_DIR/cmdpp" | awk '{print $1}')"
echo -e "  • Expected Binary SHA:   \033[1;32m${EXPECTED_BINARY_SHA}\033[0m"
echo -e "  • Actual Binary SHA:     \033[1;32m${ACTUAL_BINARY_SHA}\033[0m"

if [[ "$ACTUAL_BINARY_SHA" != "$EXPECTED_BINARY_SHA" ]]; then
  handle_failure "BINARY CHECKSUM VERIFICATION FAILED! The extracted executable does not match the committed hash."
fi
echo -e "\033[1;32m  [✓] Binary integrity:    VERIFIED MATCH\033[0m"

mkdir -p "$PLUGIN_DIR/bin"
mv "$TMP_DIR/cmdpp" "$LOCAL_BIN"
chmod +x "$LOCAL_BIN"
echo -e "\033[1;32m  [✓] Safe deployment:     Installed to ${LOCAL_BIN}\033[0m"

# ==============================================================================
# Step 4: Ask User Permission Before First Execution
# ==============================================================================
echo -e "\n\033[1;32m=====================================================\033[0m"
echo -e "\033[1m       All security verification checks passed!      \033[0m"
echo -e "\033[1;32m=====================================================\033[0m\n"

read -r -p "Launch Command++ now? [Y/n] " execute_confirm || execute_confirm=""
case "$execute_confirm" in
  [nN][oO]|[nN])
    echo -e "\nSetup completed successfully. Press \033[1mSUPER + SHIFT + H\033[0m anytime to launch."
    sleep 1
    exit 0
    ;;
  *)
    exec "$LOCAL_BIN" "$@"
    ;;
esac
