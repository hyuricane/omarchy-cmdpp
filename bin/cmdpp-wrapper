#!/bin/bash
set -euo pipefail

# ==============================================================================
# Static Release & Security Declarations (for review verification)
# ==============================================================================
CMDPP_VERSION="0.1.0"
CMDPP_TAG="v0.1.0"
CMDPP_REPO="hyuricane/cmdpp"

# Committed SHA-256 checksums from:
# https://github.com/hyuricane/cmdpp/releases/tag/v0.1.0/checksums.txt
SHA256_AMD64="f4f76bea4c2ab0cc1e9296202fd06911075911d4ae8c45bba6552f389d5424a7"
SHA256_ARM64="69a8f1ec00c63ab7dbd25c0baca094d683b04aa0a1be4ead9c0d8378f441c376"

# Security & bounded execution limits
MAX_FILESIZE=10000000  # Strict byte ceiling (10 MB)
CONNECT_TIMEOUT=10     # Connection deadline in seconds
MAX_TIME=60            # Total execution deadline in seconds
# ==============================================================================

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_BIN="$PLUGIN_DIR/bin/cmdpp"

# 1. Prefer local verified binary if present
if [[ -x "$LOCAL_BIN" ]]; then
  exec "$LOCAL_BIN" "$@"
fi

# 2. Resolve architecture and matching committed checksum
RAW_ARCH="$(uname -m)"
case "$RAW_ARCH" in
  x86_64|amd64)
    ARCH="amd64"
    EXPECTED_SHA="$SHA256_AMD64"
    ;;
  aarch64|arm64)
    ARCH="arm64"
    EXPECTED_SHA="$SHA256_ARM64"
    ;;
  *)
    echo "Error: Unsupported CPU architecture: $RAW_ARCH" >&2
    echo "Press any key to exit..."
    read -n 1 -s
    exit 1
    ;;
esac

FILE="cmdpp_${CMDPP_VERSION}_linux_${ARCH}.tar.gz"
URL="https://github.com/${CMDPP_REPO}/releases/download/${CMDPP_TAG}/${FILE}"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# ==============================================================================
# Step 1: Request User Permission Before Download
# ==============================================================================
echo -e "\n\033[1;36m=====================================================\033[0m"
echo -e "\033[1m              Command++ (yuri.cmdpp)                \033[0m"
echo -e "\033[1;36m=====================================================\033[0m\n"

echo -e "Command++ requires the \033[1mcmdpp\033[0m TUI executable to run."
echo -e "No local binary was found in this plugin.\n"
echo -e "\033[1mArtifact Details:\033[0m"
echo -e "  • Package:      cmdpp ${CMDPP_TAG}"
echo -e "  • Architecture: ${ARCH}"
echo -e "  • Source:       https://github.com/${CMDPP_REPO}/releases/tag/${CMDPP_TAG}"
echo -e "  • Destination:  ${LOCAL_BIN}"
echo -e "  • SHA-256:      ${EXPECTED_SHA}\n"

read -r -p "Do you want to download and verify this official binary? [y/N] " download_confirm
case "$download_confirm" in
  [yY][eE][sS]|[yY])
    ;;
  *)
    echo -e "\n\033[33mSetup cancelled by user.\033[0m"
    echo -e "You can manually install cmdpp anytime from: https://github.com/${CMDPP_REPO}\n"
    read -n 1 -s -r -p "Press any key to exit..."
    exit 0
    ;;
esac

# ==============================================================================
# Step 2: Bounded Download & Checksum Verification
# ==============================================================================
echo -e "\n\033[1;34m==> Running Security & Verification Checklist...\033[0m\n"
echo -e "  [..] Downloading release archive..."

if ! curl -fsSL \
  --connect-timeout "$CONNECT_TIMEOUT" \
  --max-time "$MAX_TIME" \
  --max-filesize "$MAX_FILESIZE" \
  -o "$TMP_DIR/$FILE" \
  "$URL"; then
  echo -e "\033[1;31m  [✗] Download failed!\033[0m Could not fetch $URL" >&2
  read -n 1 -s -r -p "Press any key to exit..."
  exit 1
fi
echo -e "\033[1;32m  [✓]\033[0m Archive downloaded successfully (${FILE})"

ACTUAL_SHA="$(sha256sum "$TMP_DIR/$FILE" | awk '{print $1}')"

# ==============================================================================
# Step 3: Present Verification Checklist to User
# ==============================================================================
echo -e "\n\033[1m--- Verification Checklist ---\033[0m"
echo -e "  • Size constraint:      \033[1;32mPASS\033[0m (< $((MAX_FILESIZE / 1000000)) MB)"
echo -e "  • Expected SHA-256:     \033[1;32m${EXPECTED_SHA}\033[0m"
echo -e "  • Actual SHA-256:       \033[1;32m${ACTUAL_SHA}\033[0m"

if [[ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]]; then
  echo -e "\033[1;31m\n  [✗] CHECKSUM VERIFICATION FAILED!\033[0m"
  echo "The downloaded archive does not match the committed hash. Aborting."
  read -n 1 -s -r -p "Press any key to exit..."
  exit 1
fi
echo -e "\033[1;32m  [✓] Cryptographic integrity: VERIFIED MATCH\033[0m"

# Extract binary
tar -xzf "$TMP_DIR/$FILE" -C "$TMP_DIR"
if [[ ! -f "$TMP_DIR/cmdpp" ]]; then
  echo -e "\033[1;31m\n  [✗] Extraction error:\033[0m binary 'cmdpp' not found in archive." >&2
  read -n 1 -s -r -p "Press any key to exit..."
  exit 1
fi

mkdir -p "$PLUGIN_DIR/bin"
mv "$TMP_DIR/cmdpp" "$LOCAL_BIN"
chmod +x "$LOCAL_BIN"
echo -e "\033[1;32m  [✓] Safe extraction: Installed to ${LOCAL_BIN}\033[0m"

# ==============================================================================
# Step 4: Ask User Permission Before First Execution
# ==============================================================================
echo -e "\n\033[1;32m=====================================================\033[0m"
echo -e "\033[1m       All security verification checks passed!      \033[0m"
echo -e "\033[1;32m=====================================================\033[0m\n"

read -r -p "Launch Command++ now? [Y/n] " execute_confirm
case "$execute_confirm" in
  [nN][oO]|[nN])
    echo -e "\nSetup completed successfully. Press \033[1mSUPER + SHIFT + H\033[0m anytime to launch."
    sleep 1
    exit 0
    ;;
  *)
    exec "$LOCAL_BIN" "$@"
    ;;
esac
